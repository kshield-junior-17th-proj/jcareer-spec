        <mxCell id="ecr" value="&lt;b&gt;실행 이미지 보관&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C45500&quot; font-size=&quot;13&quot;&gt;Amazon ECR&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#18212B;fillColor=#ED7100;strokeColor=#FFFFFF;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=16;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="support">
          <mxGeometry x="180" y="80" width="90" height="90" as="geometry" />
