        <mxCell id="cloudwatch" value="&lt;b&gt;실행 기록 보관&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A02D6F&quot; font-size=&quot;13&quot;&gt;Amazon CloudWatch Logs&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#18212B;fillColor=#E7157B;strokeColor=#FFFFFF;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=16;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="support">
