# Synthetic local runtime only. Do not place real provider keys or candidate data here.
SESSION_SIGNING_KEY=replace-with-a-local-random-value
LLM_PROVIDER=local-synthetic-stub
ALLOW_BEDROCK_LIVE=false
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# API data ownership. Compose supplies synthetic defaults; do not reuse one URL
# for both stores.
MEMBER_DATABASE_URL=postgresql+psycopg://jcareer_member_app:synthetic-member-db-password@postgres:5432/jcareer_member
COMPANY_DATABASE_URL=postgresql+psycopg://jcareer_company_app:synthetic-company-db-password@postgres:5432/jcareer_company
OUTCOME_DATABASE_URL=postgresql+psycopg://jcareer_outcome_app:synthetic-outcome-db-password@postgres:5432/jcareer_outcome
LLM_STUB_MODE=success
LLM_STUB_TIMEOUT_SECONDS=3
ASIS_RAW_PROMPT_LOG=true

# Rights/evidence capture. disabled is the safe default; shadow never blocks the
# existing recommendation response, while enforced fails closed on receipt loss.
TRACE_MODE=disabled
TRACE_SUBJECT_KEY=replace-with-a-local-random-value

# OpenDART company enrichment. fixture_inline performs no network or AWS I/O.
# serverless_queue requires separately approved AWS queue/worker wiring.
OPENDART_DISPATCH_MODE=fixture_inline
OPENDART_REFRESH_QUEUE_URL=
OPENDART_RESULT_TABLE=
OPENDART_PENDING_TIMEOUT_SECONDS=1800

# Admin-only outbound integration probes. Every adapter remains off unless the
# global switch, its provider switch, and a valid exact-host allowlist are set.
# Use synthetic/non-personal destinations and inject real secrets outside Git.
INTEGRATIONS_ENABLED=false
INTEGRATION_TIMEOUT_SECONDS=3
INTEGRATION_IDEMPOTENCY_TTL_SECONDS=900
INTEGRATION_IDEMPOTENCY_MAX_ENTRIES=1000

SLACK_WEBHOOK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_ALLOWED_HOSTS=hooks.slack.com

NOTION_API_ENABLED=false
NOTION_API_BASE_URL=https://api.notion.com
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_ALLOWED_HOSTS=api.notion.com

SMTP_TLS_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=implicit
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=
SMTP_ALLOWED_HOSTS=

# P1 remains disabled. The P0 golden flow must not depend on these flags.
FLAG_LANDING=false
FLAG_PROFILE=false
FLAG_GITHUB=false
FLAG_KAKAO=false
FLAG_VERIFY=false
FLAG_SHORTLIST=false
FLAG_VIEWLOG=false
FLAG_ADMIN_VIEW=false
FLAG_INTEGRATIONS=false
FLAG_MAIL=false
